{
  "name": "noteweave-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "build:noteweave": "vue-tsc -b && VITE_BASE_PATH=/noteweave/ vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
